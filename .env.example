NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=3000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/epidemiology_tracker
JWT_SECRET=generate_a_random_value_of_at_least_32_characters
ALLOW_MOCK_PROVIDERS=false
ALLOW_DEMO_SEED=false
ENABLE_LEGACY_SCHEMA_BOOTSTRAP=false
ENABLE_LEGACY_PROVIDER_ROUTES=false
ENABLE_UNTRUSTED_EXECUTION=false
OPENROUTER_API_KEY=
EHR_FHIR_API_KEY=
PUBLIC_HEALTH_REGISTRY_KEY=
LABORATORY_API_KEY=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
